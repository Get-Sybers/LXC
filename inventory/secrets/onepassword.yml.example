---
# Example for inventory/secrets/onepassword.yml — the single vaulted file that
# drives reflect-onepassword-credentials.yml. Copy it, fill in the placeholders,
# then ansible-vault encrypt it (it is gitignored, but encrypt anyway):
#
#   cp onepassword.yml.example onepassword.yml
#   ansible-vault encrypt onepassword.yml
#   ansible-playbook playbooks/reflect-onepassword-credentials.yml \
#     -e @inventory/secrets/onepassword.yml --ask-vault-pass
#
# See doc/howto/deploy-onepassword-connect.md for how to obtain the host, vault id and token.

# --- Connection to the self-hosted 1Password Connect server ---
onepassword_host: "http://CHANGE-ME-CONNECT-LXC-IP:8080"
onepassword_vault_id: "CHANGE-ME-VAULT-UUID"
onepassword_token: "CHANGE-ME-CONNECT-ACCESS-TOKEN"
onepassword_validate_certs: false

# --- The credentials to mirror ---
# Each entry becomes one 1Password item, reconciled by title (re-running is
# idempotent). field_type is one of: string, email, concealed, url, otp, date,
# month_year. Put real values here only in the encrypted onepassword.yml.
onepassword_mirror_items:
  - title: "Ludus RA API key"
    category: api_credential
    fields:
      - { label: credential, field_type: concealed, value: "CHANGE-ME" }
  - title: "Proxmox ghost9 deploy token"
    category: api_credential
    fields:
      - { label: token_id, field_type: string, value: "ghost9-deploy@pve!svc" }
      - { label: token_secret, field_type: concealed, value: "CHANGE-ME" }
  - title: "PocketBase superuser (root@ludus.internal)"
    category: password
    fields:
      - { label: username, field_type: string, value: "root@ludus.internal" }
      - { label: password, field_type: concealed, value: "CHANGE-ME" }
