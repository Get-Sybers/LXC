---
# Example for inventory/secrets/semaphore.yml — the vaulted file that gives
# deploy-semaphore.yml the administrator and the keys. Copy it, fill in the
# placeholders, then ansible-vault encrypt it (it is gitignored, but encrypt
# anyway):
#
#   cp semaphore.yml.example semaphore.yml
#   ansible-vault encrypt semaphore.yml
#   ansible-playbook playbooks/deploy-semaphore.yml \
#     -e @inventory/secrets/semaphore.yml --ask-vault-pass
#
# See doc/howto/deploy-semaphore.md.

# --- The administrator (created once, when absent; managed in the UI after) ---
lxc_semaphore_admin_login: admin
lxc_semaphore_admin_name: "Semaphore Admin"
lxc_semaphore_admin_email: "CHANGE-ME@example.test"
lxc_semaphore_admin_password: "CHANGE-ME"

# --- The keys: three independent values, each `head -c32 /dev/urandom | base64` ---
# cookie_hash signs the session cookie, cookie_encryption encrypts it, and
# access_key_encryption encrypts every access key (SSH keys, passwords,
# tokens) Semaphore stores. Changing access_key_encryption after first use
# makes every stored key unreadable; keep this file.
lxc_semaphore_cookie_hash: "CHANGE-ME"
lxc_semaphore_cookie_encryption: "CHANGE-ME"
lxc_semaphore_access_key_encryption: "CHANGE-ME"
