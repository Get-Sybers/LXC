# {{ ansible_managed }}
[Unit]
Description=Semaphore UI
Documentation=https://docs.semaphoreui.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ lxc_semaphore_user }}
Group={{ lxc_semaphore_user }}
WorkingDirectory={{ lxc_semaphore_home }}
Environment=HOME={{ lxc_semaphore_home }}
ExecStart={{ lxc_semaphore_bin }} server --config={{ lxc_semaphore_config_file }}
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
