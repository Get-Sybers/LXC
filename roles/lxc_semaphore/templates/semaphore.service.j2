# {{ ansible_managed }}
[Unit]
Description=Semaphore UI
Documentation=https://docs.semaphoreui.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ lxc_semaphore_user }}
Group={{ lxc_semaphore_user }}
WorkingDirectory={{ lxc_semaphore_home }}
Environment=HOME={{ lxc_semaphore_home }}
ExecStart={{ lxc_semaphore_bin }} server --config={{ lxc_semaphore_config_file }}
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# Least-privilege sandbox (offsets the nesting AppArmor profile; premise rule 11).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ lxc_semaphore_home }}
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
