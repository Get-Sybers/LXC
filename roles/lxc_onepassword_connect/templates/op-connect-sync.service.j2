# {{ ansible_managed }}
[Unit]
Description=1Password Connect Sync
Documentation=https://developer.1password.com/docs/connect/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ lxc_onepassword_connect_user }}
WorkingDirectory={{ lxc_onepassword_connect_home }}
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# connect-sync and connect-api both default to port 8080 and share this
# container's network namespace; sync moves, as 1Password's single-pod
# deployment sets it.
Environment=OP_HTTP_PORT={{ lxc_onepassword_connect_sync_port }}
ExecStart={{ lxc_onepassword_connect_bin_dir }}/connect-sync
Restart=always
RestartSec=5
# Least-privilege sandbox (offsets the nesting AppArmor profile; premise rule 11).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ lxc_onepassword_connect_data_dir }}
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
