# Managed by get_sybers.lxc (lxc_guest). Do not edit by hand.
# Default-deny inbound: this guest is reached over pct exec from the node, not
# the network. Only the ports below are open; egress is allowed.
[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT
dhcp: 1
ndp: 1

[RULES]
{% for r in lxc_guest_firewall_allow %}
IN ACCEPT -p {{ r.proto | default('tcp') }} -dport {{ r.port }}{% if r.comment is defined %} # {{ r.comment }}{% endif %}
{% endfor %}
