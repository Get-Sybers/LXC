# {{ ansible_managed }}
[Unit]
Description=Velociraptor DFIR server
Documentation=https://docs.velociraptor.app/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ lxc_velociraptor_user }}
Group={{ lxc_velociraptor_user }}
WorkingDirectory={{ lxc_velociraptor_datastore }}
Environment=HOME={{ lxc_velociraptor_datastore }}
ExecStart={{ lxc_velociraptor_bin }} --config {{ lxc_velociraptor_config_file }} frontend -v
Restart=always
RestartSec=5
LimitNOFILE=65536
# Least-privilege sandbox (offsets the nesting AppArmor profile; premise rule 11).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ lxc_velociraptor_datastore }}
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Velociraptor probes optional kernel facilities (the bpf() syscall) at startup.
# Return EPERM for filtered syscalls instead of SIGSYS-killing the process, so
# the probe degrades gracefully; the syscalls outside @system-service stay denied.
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
