# {{ ansible_managed }}
[Service]
Environment=GF_AUTH_ANONYMOUS_ENABLED=true
Environment=GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
Environment=GF_AUTH_DISABLE_LOGIN_FORM=true
Environment=GF_SECURITY_ALLOW_EMBEDDING=true
Environment=GF_SECURITY_X_FRAME_OPTIONS=
Environment="GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/provisioning/dashboards/GHOSTS-default Grafana dashboard.json"
