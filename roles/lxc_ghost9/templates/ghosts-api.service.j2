# {{ ansible_managed }}
[Unit]
Description=GHOSTS API (.NET)
Documentation=https://github.com/cmu-sei/GHOSTS
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User={{ lxc_ghost9_api_user }}
Group={{ lxc_ghost9_api_user }}
WorkingDirectory={{ lxc_ghost9_api_root }}
StateDirectory=ghost9
Environment=HOME=/var/lib/ghost9
Environment=ASPNETCORE_URLS=http://*:{{ lxc_ghost9_api_port }}
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_NOLOGO=1
EnvironmentFile=-/etc/ghost9/api.env
ExecStart=/usr/bin/dotnet {{ lxc_ghost9_api_root }}/ghosts.api.dll
Restart=always
RestartSec=5
LimitNOFILE=65536
ReadWritePaths={{ lxc_ghost9_api_root }}/logs
# Least-privilege sandbox (offsets the nesting AppArmor profile; premise rule 11).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# GHOSTS (.NET / Node) probes optional kernel facilities at startup; return
# EPERM for filtered syscalls instead of SIGSYS-killing the process.
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
