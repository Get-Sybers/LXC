# {{ ansible_managed }}
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port={{ lxc_ghost9_db_port }};Database={{ lxc_ghost9_db_name }};User Id={{ lxc_ghost9_db_user }};Password={{ lxc_ghost9_db_password }};
N8N_API_URL=http://127.0.0.1:{{ lxc_ghost9_n8n_port }}/api/v1/workflows
